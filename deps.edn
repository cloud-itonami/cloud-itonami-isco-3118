{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}}
 :aliases
 {
  ;; clj-kondo from deps (no binary), errors fail CI. Added because this repo
  ;; could not be linted at all -- across this fleet an absent or broken :lint
  ;; alias is what let misplaced docstrings, dead code and even a false-green
  ;; test verdict survive unreported (cloud-itonami-isic-561/563/920).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; The governed-scenario gate. Exits non-zero when the scenario table
  ;; demonstrated no refusal at all -- a harness that cannot fail is the shape
  ;; this workspace keeps catching, so it refuses to report a pass instead.
  :sim {:main-opts ["-m" "technical-drafting.sim"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :scope-exclusions
  {;; Scope rules per CLAUDE.md § "`.cljc` / `.kotoba` runtime priority"
   ;; This repo is cljs-first portable code (no JVM-only constructs)
   ;; Target platforms: kototama wasm actor host + browser WASM/JS + nbb CLI
   ;; Second-rank: ClojureScript ES modules (browser), Chicory (test compat)
   ;; Last: JVM standalone (not the app target), bb (not the app target)
   :clj  ["JVM-only constructs; this actor is .cljc portable"]
   :bb   ["babashka (not app runtime; tools only)"]}}}
