;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a technical drafting robot prepares technical
;; drawings, revisions and specification notes for draughtspersons
;; (ISCO 3118). Its physical work is the drawing output: loading a paper roll
;; onto the wide-format plotter spindle, and carrying plotted drawing sets to
;; the reprographics / site office.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3118"
 :cases
 [{:id :paper-roll-onto-plotter
   :kind :manipulator
   :procedure "arm lifts a wide-format paper roll from the floor stock and sets it on the plotter's roll spindle"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 0.10] :to [0.35 0.75] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 4.0 6.0 9.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 90.0 :basis "estimate: continuous shoulder torque of a medium collaborative arm (~10 kg payload class) at this reach"}
   :boundary {:lo 0.5 :hi 40.0}}
  {:id :drawing-set-courier
   :kind :transport
   :procedure "courier robot carries plotted drawing sets from the plotter room to the reprographics / site office"
   :params {:mass-kg 40.0 :payload-kg 8.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 100.0 :crr 0.02
            :cog-height-m 0.55 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [20.0 40.0 60.0 90.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 75.0 :basis "estimate: one leg short enough that a revised drawing reaches the office within the same review meeting"}
   :boundary {:lo 5.0 :hi 300.0}}]}
